# Application Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or Docker)
# In Docker Compose, the service name is 'mongodb', so: mongodb://mongodb:27017/college_reviews
MONGO_URI=mongodb://localhost:27017/college_reviews

# JWT Authentication
JWT_SECRET=college_review_system_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
